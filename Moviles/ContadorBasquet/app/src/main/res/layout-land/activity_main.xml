        app:layout_constraintTop_toTopOf="@+id/guidelineTop" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/_33"
        android:textColor="@color/green"
        android:textSize="90sp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineScoreBottom"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenterLeft"
        app:layout_constraintStart_toStartOf="@+id/guidelineLeft"
        app:layout_constraintTop_toTopOf="@+id/guidelineScoreTop" />


    <TextView
        android:id="@+id/textViewFoulsSeparator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/x"
        android:textColor="@color/yellow"
        android:textSize="40sp"
        app:layout_constraintBottom_toTopOf="@+id/guideline27"
        app:layout_constraintEnd_toStartOf="@+id/guidelineCenterRight"
        app:layout_constraintStart_toStartOf="@+id/guidelineCenterLeft"
        app:layout_constraintTop_toTopOf="@+id/guidelineBottom" />


    <TextView
        android:id="@+id/textView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/equipo2"
        android:textColor="@color/white"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/guidelineScoreTop"
        app:layout_constraintEnd_toEndOf="@+id/guidelineRight"
        app:layout_constraintStart_toStartOf="@+id/guidelineCenterRight"
        app:layout_constraintTop_toTopOf="@+id/guidelineTop" />


    <TextView
        android:id="@+id/textView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
